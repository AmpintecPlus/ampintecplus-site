---
layout: base.njk
title: 品質保證與檢測能力｜AS9100D、ISO 9001
description: AMPINTEC PLUS 通過 AS9100D、ISO 9001 品質管理體系，提供金相分析、拉伸強度分析、3D掃描與三次元量測等完善檢測能力，公差精度媲美精密鑄造，最薄可列印0.5mm薄壁。
---
{% set i = i18n.zh %}

<section class="section section-light" id="quality">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{{ i.nav.quality }}</span>
      <h1 class="section-title">{{ i.quality.title }}</h1>
    </div>

    <!-- 認證徽章：只列名稱 -->
    <div class="quality-badges">
      <div class="quality-badge">
        <div class="badge-name">{{ i.quality.b1_name }}</div>
      </div>
      <div class="quality-badge">
        <div class="badge-name">{{ i.quality.b2_name }}</div>
      </div>
    </div>

    <!-- 公差對比 Before/After -->
    <div class="compare-container">
      <div class="compare-info">
        <h2>{{ i.quality.precision_title }}</h2>
        <p>{{ i.quality.precision_desc1 }}</p>
        <img src="{{ '/assets/img/quality-scan.webp' | url }}" alt="金相與尺寸檢測掃描示意圖" width="1024" height="1024" loading="lazy" decoding="async" class="compare-info-img">
      </div>
      <div class="compare-cards">
        <div class="compare-card">
          <div class="compare-card-title">{{ i.quality.compare1_title }}</div>
          <div class="compare-values">
            <div class="comp-val val-before">
              <span class="val-num">{{ i.quality.p_before1 }}</span>
              <span class="val-lbl">Typical AM</span>
            </div>
            <div class="comp-val val-after">
              <span class="val-num">{{ i.quality.p_after1 }}</span>
              <span class="val-lbl">AMPINTEC PLUS</span>
            </div>
          </div>
          <div class="compare-card-note">{{ i.quality.precision_note }}</div>
        </div>
        <div class="compare-card">
          <div class="compare-card-title">{{ i.quality.compare2_title }}</div>
          <div class="compare-values compare-values-single">
            <div class="comp-val val-after">
              <span class="val-num">{{ i.quality.p_after2 }}</span>
              <span class="val-lbl">AMPINTEC PLUS</span>
            </div>
          </div>
          <div class="compare-card-note">{{ i.quality.precision_note }}</div>
        </div>
      </div>
    </div>

    <!-- 檢測能力網格 -->
    <h2 style="text-align: center; font-size: 1.5rem; font-weight: 800; margin-bottom: 30px;">{{ i.quality.detect_title }}</h2>
    <div class="detector-grid">
      <div class="detector-card">
        <span class="detector-icon detector-icon-svg" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="6" r="2.5"/><path d="M12 8.5V13"/><path d="M6 13h12"/><path d="M9 20h6"/><path d="M9 20c0-3 1-7 3-7s3 4 3 7"/></svg></span>
        <span class="detector-name">{{ i.quality.d1 }}</span>
      </div>
      <div class="detector-card">
        <span class="detector-icon detector-icon-svg" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 12h10"/><path d="M5 9l-2 3 2 3"/><path d="M19 9l2 3-2 3"/></svg></span>
        <span class="detector-name">{{ i.quality.d2 }}</span>
      </div>
      <div class="detector-card">
        <span class="detector-icon detector-icon-svg" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16l-6 8v6l-4 2v-8Z"/></svg></span>
        <span class="detector-name">{{ i.quality.d3 }}</span>
      </div>
      <div class="detector-card">
        <span class="detector-icon detector-icon-svg" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12"/><path d="M6 21h12"/><path d="M6 3c0 6 6 6 6 9s-6 3-6 9"/><path d="M18 3c0 6-6 6-6 9s6 3 6 9"/></svg></span>
        <span class="detector-name">{{ i.quality.d4 }}</span>
      </div>
      <div class="detector-card">
        <span class="detector-icon detector-icon-svg" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 L20 6.5 V17.5 L12 22 L4 17.5 V6.5 Z"/><path d="M4 9h16"/></svg></span>
        <span class="detector-name">{{ i.quality.d5 }}</span>
      </div>
      <div class="detector-card">
        <span class="detector-icon detector-icon-svg" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 L17 9 L12 15 L7 9 Z"/><path d="M4 20h16"/><path d="M12 15v5"/></svg></span>
        <span class="detector-name">{{ i.quality.d6 }}</span>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section section-dark" id="quality-cta">
  <div class="container home-cta-wrap">
    <h2 class="section-title">{{ i.home.cta_title }}</h2>
    <p>{{ i.contact.cta_desc }}</p>
    <div class="hero-btns" style="justify-content:center; margin-top: 24px;">
      <a href="{{ ('/zh/contact/') | url }}" class="btn btn-primary">{{ i.nav.cta }}</a>
    </div>
  </div>
</section>
